[Desktop Entry]
# The version of the desktop entry spec this conforms to.
Version=1.0

Type=Application

Name=Warp
GenericName=TerminalEmulator

# `warp` is a symlink to /opt/warp/warp in deb/rpm packages,
# and a /usr/bin/warp wrapper script in the arch package -- all three can be invoked directly from PATH.
# When packaging the AppImage, bundle_appimage uses sed to replace this line with `Exec=warp %U`,
# pointing directly at the binary inside the AppImage.
Exec=warp %U
StartupWMClass=dev.warp.Warp

Keywords=shell;prompt;command;commandline;cmd;

Icon=dev.warp.Warp

Categories=System;TerminalEmulator;

# Don't run this application within a terminal.
Terminal=false

# Register ourselves as the handler for warp:// URLs.
MimeType=x-scheme-handler/warp;
