---
import GhIcon from './GhIcon.astro';
import LanguageSelect from './LanguageSelect.astro';
import ThemeToggle from './ThemeToggle.astro';
const repo = 'https://github.com/zerx-lab/zap';
---
<header class="nav">
  <div class="nav-inner">
    <a class="brand" href="/">
      <img class="brand-logo" src="/logo.svg" alt="Zap" width="26" height="26" />
      Zap
    </a>
    <nav class="nav-links">
      <a href="/" data-lang="en">README</a><a href="/" data-lang="zh">Home</a><a href="/" data-lang="ja">Home</a>
      <a href="/docs/quickstart" class="active" data-lang="en">Docs</a><a href="/docs/quickstart" class="active" data-lang="zh">Docs</a><a href="/docs/quickstart" class="active" data-lang="ja">Docs</a>
      <a href={repo} target="_blank" rel="noopener" data-lang="en">Providers</a><a href={repo} target="_blank" rel="noopener" data-lang="zh">Providers</a><a href={repo} target="_blank" rel="noopener" data-lang="ja">Providers</a>
      <a href="/changelog" data-lang="en">Changelog</a><a href="/changelog" data-lang="zh">Changelog</a><a href="/changelog" data-lang="ja">Changelog</a>
    </nav>
    <div class="nav-spacer"></div>
    <div class="nav-right">
      <ThemeToggle />
      <LanguageSelect />
      <a class="gh-link" href={repo} target="_blank" rel="noopener">
        <GhIcon /><span>GitHub</span>
      </a>
    </div>
  </div>
</header>
