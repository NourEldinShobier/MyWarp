---
import '../styles/docs.css';
import I18nScript from '../components/I18nScript.astro';
import Banner from '../components/Banner.astro';
import DocsNav from '../components/DocsNav.astro';
import DocsSidebar from '../components/DocsSidebar.astro';
import Analytics from '../components/Analytics.astro';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  title_zh: string;
  title_ja: string;
  lede: string;
  lede_zh: string;
  lede_ja: string;
  section: string;
  section_zh: string;
  section_ja: string;
  activeSlug: string;
  headings: Heading[];
  prev?: { slug: string; title: string; title_zh: string; title_ja: string } | null;
  next?: { slug: string; title: string; title_zh: string; title_ja: string } | null;
}

const { title, title_zh, title_ja, lede, lede_zh, lede_ja, section, section_zh, section_ja, activeSlug, headings, prev, next } = Astro.props;
const tocItems = headings.filter((h) => h.depth === 2);
const repo = 'https://github.com/zerx-lab/zap';
const editUrl = `${repo}/blob/main/website/src/content/docs/${activeSlug}.mdx`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{`Zap · Docs · ${title}`}</title>
    <meta name="description" content={lede} />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
    <Analytics />
    {/* FOUC guard */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('zap:theme');
          var theme = stored;
          if (!theme || (theme !== 'light' && theme !== 'dark')) {
            theme = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
          }
          document.documentElement.setAttribute('data-theme', theme);
        } catch (_) {}
        try {
          var lc = localStorage.getItem('zap:locale');
          if (!lc) {
            var nav = (navigator.language || 'en').toLowerCase();
            lc = nav.startsWith('zh') ? 'zh' : nav.startsWith('ja') ? 'ja' : 'en';
          }
          document.documentElement.setAttribute('data-locale', lc);
        } catch (_) {}
      })();
    </script>
  </head>
  <body data-locale="en">
    <I18nScript />
    <Banner
      en="Early development · Docs are evolving alongside the source · An independent product built on Warp"
      zh="Early development · Docs are evolving alongside the source · An independent product built on Warp"
      ja="Early development · Docs are evolving alongside the source · An independent product built on Warp"
    />
    <DocsNav />

    <div class="docs-shell">
      <DocsSidebar activeSlug={activeSlug} />

      <main class="doc">
        <div class="doc-toolbar">
          <div class="doc-toolbar-left">
            <button class="docs-toggle" type="button" id="docs-sidebar-toggle" aria-controls="docs-sidebar" aria-label="Toggle docs menu">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
            </button>
            <div class="crumbs">
              <span data-lang="en">DOCS</span><span data-lang="zh">DOCS</span>
              <span data-lang="ja">DOCS</span>
              <span class="sep">/</span>
              <span data-lang="en">{section}</span><span data-lang="zh">{section_zh}</span>
              <span data-lang="ja">{section_ja}</span>
              <span class="sep">/</span>
              <span class="here" data-lang="en">{title}</span><span class="here" data-lang="zh">{title_zh}</span>
              <span class="here" data-lang="ja">{title_ja}</span>
            </div>
          </div>
          <div class="doc-actions">
            <button id="copy-md" type="button">
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="4.5" y="4.5" width="8" height="9" rx="1"/><path d="M3 11V3h7"/></svg>
              <span data-lang="en">Copy MD</span><span data-lang="zh">Copy MD</span>
              <span data-lang="ja">Copy MD</span>
            </button>
            <a href={editUrl} target="_blank" rel="noopener">
              <span data-lang="en">Open in GitHub</span><span data-lang="zh">Open in GitHub</span>
              <span data-lang="ja">Open in GitHub</span>
              <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M4 8l4-4M4 4h4v4"/></svg>
            </a>
          </div>
        </div>

        <h1 class="doc-title" data-lang="en">{title}</h1>
        <h1 class="doc-title" data-lang="zh">{title_zh}</h1>
        <h1 class="doc-title" data-lang="ja">{title_ja}</h1>
        <p class="doc-lede" data-lang="en">{lede}</p>
        <p class="doc-lede" data-lang="zh">{lede_zh}</p>
        <p class="doc-lede" data-lang="ja">{lede_ja}</p>

        <slot />

        {(prev || next) && (
          <div class="pager">
            {prev ? (
              <a href={`/docs/${prev.slug}`}>
                <div class="lbl" data-lang="en">← Previous</div><div class="lbl" data-lang="zh">← Previous</div>
                <div class="lbl" data-lang="ja">← Previous</div>
                <div class="ttl" data-lang="en">{prev.title}</div><div class="ttl" data-lang="zh">{prev.title_zh}</div>
                <div class="ttl" data-lang="ja">{prev.title_ja}</div>
              </a>
            ) : <span />}
            {next ? (
              <a class="next" href={`/docs/${next.slug}`}>
                <div class="lbl" data-lang="en">Next →</div><div class="lbl" data-lang="zh">Next →</div>
                <div class="lbl" data-lang="ja">Next →</div>
                <div class="ttl" data-lang="en">{next.title}</div><div class="ttl" data-lang="zh">{next.title_zh}</div>
                <div class="ttl" data-lang="ja">{next.title_ja}</div>
              </a>
            ) : <span />}
          </div>
        )}
      </main>

      <aside class="toc">
        <div class="toc-head">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 4h10M3 8h10M3 12h7"/></svg>
          <span data-lang="en">On this page</span><span data-lang="zh">On this page</span>
          <span data-lang="ja">On this page</span>
        </div>
        {tocItems.map((h) => (
          <a href={`#${h.slug}`} data-toc>{h.text}</a>
        ))}
      </aside>
    </div>

    <div class="search-modal" id="docs-search-modal" hidden>
      <div class="search-modal-backdrop" data-search-close></div>
      <div class="search-modal-panel">
        <div id="docs-search-ui"></div>
      </div>
    </div>

    <script src="/pagefind/pagefind-ui.js" is:inline></script>
    <script>
      (function () {
        const htmlLang: Record<string, string> = { en: 'en', zh: 'zh-CN', ja: 'ja' };
        function normalizeLocale(value: string | null) {
          const tag = String(value || '').toLowerCase();
          if (tag.startsWith('zh')) return 'zh';
          if (tag.startsWith('ja')) return 'ja';
          if (tag.startsWith('en')) return 'en';
          return htmlLang[tag] ? tag : null;
        }
        function applyLocale(l: string) {
          const locale = normalizeLocale(l) || 'en';
          document.body.dataset.locale = locale;
          document.documentElement.lang = htmlLang[locale] || 'en';
          document.querySelectorAll<HTMLElement>('[data-set-lang]').forEach((option) => {
            const active = option.getAttribute('data-set-lang') === locale;
            option.classList.toggle('active', active);
            option.setAttribute('aria-selected', String(active));
          });
        }
        function closeLocaleMenus() {
          document.querySelectorAll<HTMLElement>('[data-locale-options]').forEach((menu) => {
            menu.hidden = true;
          });
          document.querySelectorAll<HTMLElement>('[data-locale-trigger]').forEach((trigger) => {
            trigger.setAttribute('aria-expanded', 'false');
          });
          document.querySelectorAll<HTMLElement>('[data-locale-menu]').forEach((menu) => {
            menu.removeAttribute('data-open');
          });
        }
        function setLocale(l: string) {
          // Persist only when the user explicitly picks a language; auto-detection should keep following the system/browser on later visits.
          const locale = normalizeLocale(l) || 'en';
          localStorage.setItem('zap:locale', locale);
          applyLocale(locale);
        }
        applyLocale((document.body.dataset.locale as string) || 'en');
        document.querySelectorAll<HTMLElement>('[data-locale-menu]').forEach((menu) => {
          const trigger = menu.querySelector<HTMLButtonElement>('[data-locale-trigger]');
          const options = menu.querySelector<HTMLElement>('[data-locale-options]');
          if (!trigger || !options) return;
          trigger.addEventListener('click', (event) => {
            event.stopPropagation();
            const shouldOpen = options.hidden;
            closeLocaleMenus();
            options.hidden = !shouldOpen;
            trigger.setAttribute('aria-expanded', String(shouldOpen));
            if (shouldOpen) menu.setAttribute('data-open', 'true');
          });
          menu.querySelectorAll<HTMLButtonElement>('[data-set-lang]').forEach((option) => {
            option.addEventListener('click', (event) => {
              event.stopPropagation();
              setLocale(option.getAttribute('data-set-lang') || 'en');
              closeLocaleMenus();
            });
          });
        });
        document.addEventListener('click', (event) => {
          const target = event.target as Element | null;
          if (!target?.closest('[data-locale-menu]')) closeLocaleMenus();
        });
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') closeLocaleMenus();
        });

        // Theme toggle
        function applyTheme(theme: string) {
          document.documentElement.setAttribute('data-theme', theme);
          try { localStorage.setItem('zap:theme', theme); } catch (_) {}
        }
        document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
          btn.addEventListener('click', () => {
            const cur = document.documentElement.getAttribute('data-theme') || 'dark';
            applyTheme(cur === 'dark' ? 'light' : 'dark');
          });
        });

        // Mobile sidebar toggle
        const toggle = document.getElementById('docs-sidebar-toggle');
        const sidebar = document.getElementById('docs-sidebar');
        const backdrop = document.getElementById('docs-sidebar-backdrop');
        function closeSidebar() {
          sidebar?.classList.remove('open');
          backdrop?.classList.remove('open');
          if (backdrop) backdrop.hidden = true;
          toggle?.setAttribute('aria-expanded', 'false');
        }
        function openSidebar() {
          sidebar?.classList.add('open');
          backdrop?.classList.add('open');
          if (backdrop) backdrop.hidden = false;
          toggle?.setAttribute('aria-expanded', 'true');
        }
        toggle?.addEventListener('click', () => {
          if (sidebar?.classList.contains('open')) closeSidebar(); else openSidebar();
        });
        backdrop?.addEventListener('click', closeSidebar);
        sidebar?.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeSidebar));

        // Body tabs
        document.querySelectorAll<HTMLElement>('.tabs-bar').forEach((bar) => {
          const card = bar.parentElement!;
          bar.querySelectorAll<HTMLButtonElement>('button').forEach((b) => {
            b.addEventListener('click', () => {
              const name = b.getAttribute('data-tab');
              bar.querySelectorAll('button').forEach((x) => x.classList.toggle('active', x === b));
              card.querySelectorAll<HTMLElement>('[data-pane]').forEach((p) => {
                p.hidden = p.getAttribute('data-pane') !== name;
              });
            });
          });
        });

        // Copy button
        document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
          btn.addEventListener('click', () => {
            const pre = btn.closest('.code-card')?.querySelector<HTMLElement>('pre.code');
            if (pre && navigator.clipboard) navigator.clipboard.writeText(pre.innerText);
            const prev = btn.textContent;
            btn.textContent = 'Copied';
            btn.classList.add('copied');
            setTimeout(() => {
              btn.textContent = prev;
              btn.classList.remove('copied');
            }, 1400);
          });
        });

        // Copy body content: best-effort write to the clipboard from the page text
        const copyMd = document.getElementById('copy-md') as HTMLButtonElement | null;
        copyMd?.addEventListener('click', async () => {
          try {
            const main = document.querySelector('main.doc');
            const text = (main as HTMLElement | null)?.innerText || '';
            if (text && navigator.clipboard) await navigator.clipboard.writeText(text);
            const span = copyMd.querySelector(`[data-lang="${document.body.dataset.locale}"]`);
            if (span) {
              const prev = span.textContent;
              span.textContent = 'Copied';
              setTimeout(() => { span.textContent = prev; }, 1400);
            }
          } catch (_) {}
        });

        // Pagefind search dialog
        const searchModal = document.getElementById('docs-search-modal');
        const searchTrigger = document.getElementById('docs-search-trigger');
        const searchUi = document.getElementById('docs-search-ui');
        let searchInited = false;
        function openSearch() {
          if (!searchModal) return;
          searchModal.hidden = false;
          if (!searchInited && searchUi) {
            if ((window as any).PagefindUI) {
              new (window as any).PagefindUI({
                element: '#docs-search-ui',
                showSubResults: true,
                showImages: false,
                resetStyles: false,
                translations: undefined,
              });
            } else {
              searchUi.innerHTML = `<div class="search-fallback">
                <div class="t">Search is only available in production builds</div>
                <div class="d">Run <code>bun run build</code> to generate the Pagefind index under <code>dist/pagefind/</code>. Dev mode (<code>bun run dev</code>) does not produce the index.</div>
              </div>`;
            }
            searchInited = true;
          }
          setTimeout(() => {
            const input = searchUi?.querySelector<HTMLInputElement>('input');
            input?.focus();
          }, 50);
        }
        function closeSearch() { if (searchModal) searchModal.hidden = true; }
        searchTrigger?.addEventListener('click', openSearch);
        searchModal?.querySelectorAll('[data-search-close]').forEach((el) => el.addEventListener('click', closeSearch));
        document.addEventListener('keydown', (e) => {
          if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); openSearch(); }
          else if (e.key === 'Escape' && searchModal && !searchModal.hidden) { closeSearch(); }
        });

        // Update the table-of-contents highlight on scroll
        const headings = Array.from(document.querySelectorAll<HTMLElement>('main.doc h2[id]'));
        const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('aside.toc a'));
        function updateActive() {
          const y = window.scrollY + 120;
          let current = headings[0];
          headings.forEach((h) => { if (h.offsetTop <= y) current = h; });
          if (!current) return;
          tocLinks.forEach((a) => {
            a.classList.toggle('active', a.getAttribute('href') === '#' + current.id);
          });
        }
        document.addEventListener('scroll', updateActive, { passive: true });
        updateActive();
      })();
    </script>
  </body>
</html>
