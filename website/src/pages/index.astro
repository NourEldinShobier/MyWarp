  </section>

  <!-- ============== INSTALL ============== -->
  <section class="section" id="install">
    <div class="wrap">
      <div class="fade-in" style="max-width: 720px;">
        <div class="feat-eyebrow">
          <span data-lang="en">{t.install.eyebrow.en}</span>
        </div>
        <h2 class="sec-h2" data-lang="en">{t.install.h.en}</h2>
        <p class="sec-lede" data-lang="en">{t.install.p.en}</p>
      </div>

      <div class="install-card fade-in delay-1">
        <div class="install-tabs">
          <button data-tab="macos" class="active">macOS</button>
          <button data-tab="linux">Linux</button>
          <button data-tab="windows">Windows<span class="meta">.ps1</span></button>
        </div>

        <div class="pre-wrap" data-pane="macos">
          <pre class="code"><span class="com"># 1. Bootstrap dependencies (Xcode CLT + cargo helpers)</span>
git clone https://github.com/zerx-lab/zap.git zap
<span class="key">cd</span> zap
./script/bootstrap

<span class="com"># 2. Build &amp; run</span>
./script/run --release</pre>
          <button class="copy" type="button" data-copy>Copy</button>
        </div>

        <div class="pre-wrap" data-pane="linux" hidden>
          <pre class="code"><span class="com"># Debian / Ubuntu (apt + cargo)</span>
git clone https://github.com/zerx-lab/zap.git zap
<span class="key">cd</span> zap
./script/bootstrap

<span class="com"># Build &amp; run</span>
./script/run --release</pre>
          <button class="copy" type="button" data-copy>Copy</button>
        </div>

        <div class="pre-wrap" data-pane="windows" hidden>
          <pre class="code"><span class="com"># Run from PowerShell (winget + rustup)</span>
git clone https://github.com/zerx-lab/zap.git zap
<span class="key">cd</span> zap
./script/bootstrap

<span class="com"># Build &amp; run</span>
./script/run --release</pre>
          <button class="copy" type="button" data-copy>Copy</button>
        </div>
      </div>
    </div>
  </section>

  <!-- ============== CTA ============== -->
  <section class="cta-band">
    <div class="wrap fade-in">
      <h2>
        <span data-lang="en">{t.cta.h.en}</span>
      </h2>
      <p data-lang="en">{t.cta.p.en}</p>
      <div class="btn-row">
        <a class="btn" href="/docs/quickstart">
          <span data-lang="en">{t.cta.primary.en}</span>
          <span class="arr">→</span>
        </a>
        <a class="btn alt" href="/changelog">
          <span data-lang="en">{t.cta.secondary.en}</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Terminal typing lines (rendered once; typing-fade starts after LandingLayout's IntersectionObserver adds .in) -->
  <!-- The actual typing content is already filled inside the mock-terminal .term-stage -->
</LandingLayout>

<script>
  // ============================================================
  // Hero mock terminal: an interactive fake shell
  // - A few preset commands (help / ls / pwd / clear / agent / provider / theme / whoami / echo)
  // - Responses are keyed by the current locale
  // - Up/Down arrows walk the history
  // ============================================================
  (function () {
    const stage = document.querySelector('.hero-art .term-stage') as HTMLElement | null;
    if (!stage) return;

    // Initial animation lines (on page load), rendered for the current locale
    // Commands stay in English (a real shell is English too); only the human-language parts are localized
    // Story: build fails -> the AI diagnoses it from block context (cwd/exit code) and suggests a fix
    // Echoes the feat1 copy "Every Block — cwd, env, exit code — feeds an AI conversation"
    const initLinesByLocale: Record<'en', string[]> = {
      en: [
        `<span class="p">$</span> cargo build --release`,
        `<span class="dim">   Compiling zap v0.1.0</span>`,
        `<span class="err">error[E0433]: failed to resolve: use of undeclared crate \`openssl\`</span>`,
        `<span class="err">  --&gt; src/tls.rs:4:5</span>`,
        `<div class="stage-turn">
          <div class="st-chip">block · cwd ~/zap · exit 101</div>
          <div class="st-prompt">▌ Why did this fail?</div>
          <div class="st-think">Reading block context <span class="dots"><span></span><span></span><span></span></span></div>
          <div class="st-answer"><code>openssl</code> isn't in Cargo.toml. Run <code>cargo add openssl --features vendored</code>, then rebuild.</div>
          <div class="st-meta"><span class="ok">anthropic / claude-opus-4-7</span><span>local · no telemetry</span></div>
        </div>`,
      ],
    };
    function renderInitLines() {
      stage.innerHTML = initLinesByLocale[locale()]
        .map((l) => `<div class="typing-line">${l}</div>`)
        .join('');
    }

    const inputs = Array.from(document.querySelectorAll<HTMLInputElement>('.ti-fakeshell input'));
    if (!inputs.length) {
      // Even without an input box, still render the initial animation lines
      renderInitLines();
      return;
    }
    const history: string[] = [];
    let histIdx = -1;

    function locale(): 'en' {
      return 'en';
    }

    // First render of the initial animation lines
    renderInitLines();

    function pickInput(): HTMLInputElement | null {
      const lc = locale();
      return inputs.find((el) => el.dataset.lang === lc) || inputs[0] || null;
    }
    function escape(s: string) {
      return s.replace(/&/g, '&amp;').replace(/[<]/g, '&lt;').replace(/[>]/g, '&gt;');
    }
    function printRaw(html: string, cls = '') {
      const div = document.createElement('div');
      div.className = 'out-line' + (cls ? ' ' + cls : '');
      div.innerHTML = html;
      stage.appendChild(div);
      stage.scrollTop = stage.scrollHeight;
    }
    function printLines(lines: string[], cls = '') {
      lines.forEach((l, i) => {
        setTimeout(() => printRaw(l, cls), i * 60);
      });
    }

    // Response table per locale
    const responses: Record<string, Record<'en', string[]>> = {
      help: {
        en: [
          'Available commands:',
          '  help               show this list',
          '  ls                 list current directory',
          '  pwd                print working directory',
          '  whoami             print current user',
          '  echo &lt;text&gt;        print text back',
          '  agent &lt;prompt&gt;     send a prompt to the local AI agent',
          '  provider list      list configured AI providers',
          '  theme              toggle dark / light',
          '  clear              clear the screen',
        ],
      },
      ls: {
        en: ['Cargo.toml  CHANGELOG.md  README.md  app/  crates/  docs/  scripts/  website/'],
      },
      pwd: { en: ['/home/you/zap'] },
      whoami: { en: ['you'] },
      providerList: {
        en: [
          '<span class="k">PROTOCOL</span>           <span class="k">NAME</span>          <span class="k">STATUS</span>',
          'openai            anthropic     <span class="s">ready</span>',
          'anthropic         claude-4-7    <span class="s">ready</span>',
          'deepseek          deepseek-v4   <span class="s">ready</span>',
          'ollama            local         <span class="s">ready</span>',
        ],
      },
    };

    function agentResponse(prompt: string): string[] {
      const lc = locale();
      const cleaned = prompt.trim() || 'no prompt';
      return [
        `<span class="k">[agent]</span> <span class="dim">routing to</span> anthropic/claude-4-7`,
        `<span class="k">[agent]</span> <span class="dim">prompt</span>: ${escape(cleaned)}`,
        `<span class="dim">thinking...</span>`,
        `<span class="s">→</span> This is a simulated response. In real Zap this would call your configured provider locally.`,
        `<span class="dim">Credentials, conversation and context all stay on your machine.</span>`,
      ];
    }

    function run(raw: string) {
      const cmd = raw.trim();
      if (!cmd) return;
      history.push(cmd);
      histIdx = history.length;

      // Echo the command
      printRaw(`<span class="p">$</span> ${escape(cmd)}`);

      const lc = locale();
      const lower = cmd.toLowerCase();
      const head = cmd.split(/\s+/)[0].toLowerCase();
      const rest = cmd.slice(head.length).trim();

      if (lower === 'clear' || lower === 'cls') {
        setTimeout(() => { stage.innerHTML = ''; }, 80);
        return;
      }
      if (head === 'help') { printLines(responses.help[lc], 'dim'); return; }
      if (head === 'ls')   { printLines(responses.ls[lc]); return; }
      if (head === 'pwd')  { printLines(responses.pwd[lc]); return; }
      if (head === 'whoami') { printLines(responses.whoami[lc]); return; }
      if (head === 'echo') { printRaw(escape(rest)); return; }
      if (head === 'theme') {
        const cur = document.documentElement.getAttribute('data-theme') || 'dark';
        const next = cur === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        try { localStorage.setItem('zap:theme', next); } catch (_) {}
        const msg = `Theme switched to ${next}`;
        printRaw(msg, 'ok');
        return;
      }
      if (head === 'provider' && rest === 'list') {
        printLines(responses.providerList[lc]);
        return;
      }
      if (head === 'agent') { printLines(agentResponse(rest)); return; }

      // Unknown command
      const errMsg = `zap: command not found: ${escape(head)}. Type <span class="s">help</span> to list commands.`;
      printRaw(errMsg, 'err');
    }

    inputs.forEach((input) => {
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          const val = input.value;
          input.value = '';
          run(val);
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          if (history.length === 0) return;
          histIdx = Math.max(0, histIdx - 1);
          input.value = history[histIdx] || '';
        } else if (e.key === 'ArrowDown') {
          e.preventDefault();
          if (histIdx < history.length - 1) {
            histIdx += 1;
            input.value = history[histIdx] || '';
          } else {
            histIdx = history.length;
            input.value = '';
          }
        }
      });
    });

    // The "Language" dropdown in the mock window: on click, syncs the site-wide locale to match the nav language menu.
    // This reuses the setLocale logic already in LandingLayout: write localStorage + body.dataset.locale +
    // applyLocale to take effect. To avoid rewriting it, it uses the same storage key and selectors.
    function setLocaleAcrossSite(lc) {
      const supported = ['en'];
      let actual = lc;
      if (lc === 'system') {
        const nav = (navigator.language || 'en').toLowerCase();
        actual = 'en';
      }
      if (!supported.includes(actual)) actual = 'en';
      // 1. body.dataset.locale controls [data-lang] visibility
      document.body.dataset.locale = actual;
      // 2. <html> lang attribute
      document.documentElement.lang = actual;
      // 3. <html> data-locale (for other CSS uses)
      document.documentElement.setAttribute('data-locale', actual);
      // 4. Persist, so the next visit remembers it
      try { localStorage.setItem('zap:locale', actual); } catch (_) {}
      // 5. Update the active state in the nav language dropdown
      document.querySelectorAll('[data-set-lang]').forEach((opt) => {
        const active = opt.getAttribute('data-set-lang') === actual;
        opt.classList.toggle('active', active);
        opt.setAttribute('aria-selected', String(active));
      });
      // 6. Update the active state in the mock dropdown (highlight the current option)
      document.querySelectorAll('[data-mock-lang]').forEach((opt) => {
        const v = opt.getAttribute('data-mock-lang');
        opt.classList.toggle('active', v === actual || (v === 'system' && !localStorage.getItem('zap:locale')));
      });
    }
    document.querySelectorAll('[data-mock-lang]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const target = btn.getAttribute('data-mock-lang') || 'en';
        setLocaleAcrossSite(target);
      });
    });
    // Sync the initial highlight once after page load
    document.querySelectorAll('[data-mock-lang]').forEach((opt) => {
      const v = opt.getAttribute('data-mock-lang');
      const cur = document.body.dataset.locale || 'en';
      opt.classList.toggle('active', v === cur);
    });

    // Watch for site-wide locale changes (from the nav bar, the mock dropdown or any other entry point)
    // After a switch, clear the mock terminal and reprint the initial animation lines so the demo follows the language
    let lastLocale = locale();
    const localeObserver = new MutationObserver(() => {
      const cur = locale();
      if (cur === lastLocale) return;
      lastLocale = cur;
      renderInitLines();
    });
    localeObserver.observe(document.body, { attributes: true, attributeFilter: ['data-locale'] });
  })();
</script>

<script>
  // Hero decorative equalizer bars: light parallax (translate only, GPU-composited, no layout)
  (function () {
    const eq = document.querySelector<HTMLElement>('.hero-eq');
    if (!eq) return;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion) return;
    const cols = Array.from(eq.querySelectorAll<HTMLElement>('.col'));
    let ticking = false;
    function apply() {
      const y = window.scrollY;
      const heroH = (eq.closest('.hero') as HTMLElement | null)?.offsetHeight || 800;
      const progress = Math.min(y / heroH, 1);
      cols.forEach((col, i) => {
        const dir = i % 2 === 0 ? 1 : -1;
        col.style.transform = `translateY(${progress * 40 * dir}px)`;
      });
      ticking = false;
    }
    document.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          requestAnimationFrame(apply);
          ticking = true;
        }
      },
      { passive: true },
    );
    apply();
  })();
</script>
