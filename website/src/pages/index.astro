                <a class="ss-item" data-lang="en">MCP servers</a>
                <a class="ss-item">Rules</a>
                <a class="ss-top muted" data-lang="en">Code</a>
                <a class="ss-top muted" data-lang="en">Appearance</a>
                <a class="ss-top muted" data-lang="en">Features</a>
              </div>

              <!-- Right content -->
              <div class="set-content">
                <div class="sc-head">
                  <h4 class="sc-h3">
                    <span data-lang="en">Agent providers</span>
                  </h4>
                  <button class="sc-add" type="button">+ <span data-lang="en">Add</span></button>
                </div>
                <p class="sc-desc">
                  <span data-lang="en">Configure any OpenAI-compatible / Anthropic / Gemini / Ollama / DeepSeek endpoint. Keys are stored in the OS keychain.</span>
                </p>

                <div class="sc-quickadd">
                  <div class="qa-head">
                    <span data-lang="en">Quick add</span>
