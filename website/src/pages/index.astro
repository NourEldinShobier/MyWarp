                      <span class="ptab">DeepSeek</span>
                    </div>
                  </div>
                  <div class="sf-actions">
                    <button class="sf-btn" type="button" data-lang="en">+ Add model</button>
                    <button class="sf-btn primary" type="button" data-lang="en">Save</button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </article>
    </div>
  </section>

  <!-- ============== FEAT 3: Localization ============== -->
  <section class="section" id="privacy">
    <div class="wrap">
      <article class="feat-card fade-in slide-l">
        <div class="feat-text">
          <div class="feat-eyebrow">
            <span data-lang="en">{t.feat3.eyebrow.en}</span>
          </div>
          <h3 data-lang="en">{t.feat3.h.en}</h3>
          <p data-lang="en">{t.feat3.p.en}</p>
        </div>
        <div class="feat-vis">
          <div class="app-window mock-language">
            <div class="app-titlebar">
              <div class="tb-icon"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="2" y="3" width="12" height="10" rx="1.5"/><path d="M6 3v10"/></svg></div>
              <div class="app-tabs">
                <div class="app-tab active">
                  <span data-lang="en">Settings · Appearance</span>
                </div>
                <div class="app-tab add">
                  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M8 3v10M3 8h10"/></svg>
                </div>
              </div>
            </div>
            <div class="app-body">
              <div class="lang-block">
                <div class="lb-h" data-lang="en">Language</div>
                <div class="lb-row">
                  <div class="lb-text">
                    <div class="t" data-lang="en">Language</div>
                    <div class="d" data-lang="en">Restart Zap to fully apply this change.</div>
                  </div>
                  <div class="lb-select" id="hero-lang-select">
                    <span class="lb-current" data-locale-current="en">System default</span>
                    <div class="lang-dropdown">
                      <button class="ldi" type="button" data-mock-lang="system">
                        <span data-lang="en">System default</span>
                      </button>
                      <button class="ldi" type="button" data-mock-lang="en">English</button>
                    </div>
                  </div>
                </div>
              </div>
              <div class="lang-block">
                <div class="lb-h" data-lang="en">Window</div>
                <div class="lb-row">
                  <div class="lb-text">
                    <div class="t" data-lang="en">Window opacity: 100</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </article>
    </div>
  </section>

  <!-- ============== QUOTE (single) ============== -->
  <section class="quote fade-in scale-in">
    <div class="wrap">
      <blockquote data-lang="en">{t.quote.text.en}</blockquote>
      <div class="cite">
        — <span data-lang="en">{t.quote.cite.en}</span>
      </div>
