# Global rule: all text files use LF. On Windows, pair this with git config core.autocrlf=input
# so checkout does not convert LF to CRLF, and jj does not misreport the entire working tree
# as "modified" because of CRLF/LF differences. Windows script types are the exception and keep CRLF.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.psm1 text eol=crlf

# The fixed CRLF in ref test recording files / shell bootstrap output is part of the test data semantics;
# automatic LF normalization would change it and break alacritty replay/diff tests.
*.recording -text
app/assets/bundled/bootstrap/*_subshell_bootstrap_block_output.txt -text

*.pdb filter=lfs diff=lfs merge=lfs -text
input_classifier/models/* filter=lfs diff=lfs merge=lfs -text
input_classifier/models/**/*tokenizer.json linguist-generated=true

# openWarp-specific paths: always keep the openWarp version when merging upstream
# Usage: register the driver locally first with `git config merge.openwarp-ours.driver true`
# CI / fresh clones run `script/setup-merge-drivers.sh` to configure it automatically
.github/workflows/openwarp_release.yml merge=openwarp-ours
app/channels/oss/dev.openwarp.OpenWarp.desktop merge=openwarp-ours
lib/rust-genai/** merge=openwarp-ours

# openWarp autonomous zone (BYOP / cloud cleanup / i18n / footer removals, etc. have permanently diverged)
# All upstream changes to these paths automatically keep the openWarp version
app/src/ai/agent_sdk/** merge=openwarp-ours
app/src/ai/blocklist/action_model/** merge=openwarp-ours
app/src/ai/blocklist/agent_view/** merge=openwarp-ours
app/src/ai/blocklist/controller.rs merge=openwarp-ours
app/src/ai/blocklist/controller/** merge=openwarp-ours
app/src/ai/blocklist/history_model/conversation_loader.rs merge=openwarp-ours
app/src/ai/blocklist/orchestration_event_poller*.rs merge=openwarp-ours
app/src/ai/execution_profiles/editor/** merge=openwarp-ours
app/src/terminal/input/slash_commands/** merge=openwarp-ours
app/src/terminal/view/ambient_agent/** merge=openwarp-ours
app/src/search/slash_command_menu/** merge=openwarp-ours

# openWarp-only feature: SSH manager (added 2026-05-04)
# Upstream does not have these paths; they are marked merge=openwarp-ours so that
# if upstream ever adds a file with the same name, no unexpected conflict arises.
crates/warp_ssh_manager/** merge=openwarp-ours
app/src/ssh_manager/** merge=openwarp-ours
